+def _lap_plugin_rows(b: "_PickerBuild", *, for_picker: bool, current_provider: str,
+                     current_base_url: str, current_model: str) -> None:
+    """Merge ``provider_rows`` rows from plugins (a central catalog like lLauncher needs no
+    ``custom_providers`` entries). Fail-open: a raising/slow plugin never breaks the picker."""
+    try:
+        from hermes_cli.plugins import invoke_hook
+    except Exception:
+        return
+    try:
+        supplied = invoke_hook(
+            "provider_rows", for_picker=for_picker, current_provider=current_provider,
+            current_base_url=current_base_url, current_model=current_model,
+        )
+    except Exception:
+        return
+    for supplied_rows in supplied or []:
+        if isinstance(supplied_rows, dict):
+            supplied_rows = [supplied_rows]
+        if not isinstance(supplied_rows, list):
+            continue
+        for row in supplied_rows:
+            if not isinstance(row, dict) or not row.get("slug"):
+                continue
+            slug = str(row["slug"])
+            if slug.lower() in b.seen_slugs:
+                continue
+            out = {
+                "slug": slug,
+                "name": row.get("name") or slug,
+                "is_current": bool(row.get("is_current")) or slug.lower() == b.current_provider_norm,
+                "is_user_defined": bool(row.get("is_user_defined", True)),
+                "models": list(row.get("models") or []),
+                "total_models": int(row.get("total_models") or len(row.get("models") or [])),
+                "source": row.get("source") or "plugin",
+                "api_url": row.get("api_url") or "",
+                "native_catalog_empty": bool(row.get("native_catalog_empty")),
+            }
+            b.results.append(out)
+            b.seen_slugs.add(slug.lower())
+
+
